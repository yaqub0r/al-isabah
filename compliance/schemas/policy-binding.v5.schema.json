{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "authority",
    "contracts",
    "supersedes",
    "applied_by_issue",
    "note"
  ],
  "properties": {
    "schema": {
      "const": "al-isabah.local-policy-binding.v5"
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "scope",
        "issue"
      ],
      "properties": {
        "repository": {
          "const": "https://github.com/yaqub0r/al-isabah"
        },
        "scope": {
          "const": "repository-local"
        },
        "issue": {
          "const": "https://github.com/yaqub0r/al-isabah/issues/78"
        }
      }
    },
    "contracts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "sha256"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "supersedes": {
      "const": "compliance/policy-binding.v4.json"
    },
    "applied_by_issue": {
      "const": "https://github.com/yaqub0r/al-isabah/issues/78"
    },
    "note": {
      "type": "string",
      "minLength": 1
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
