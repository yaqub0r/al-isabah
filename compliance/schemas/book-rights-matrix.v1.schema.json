{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yaqub0r/al-isabah/compliance/schemas/book-rights-matrix.v1.schema.json",
  "title": "Al-Isabah per-book rights matrix v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "matrix_id",
    "work_id",
    "title",
    "source_editions",
    "public_content_license",
    "attribution",
    "exclusions",
    "publication_decision",
    "reviewed_on",
    "follow_up_review"
  ],
  "properties": {
    "schema": { "const": "al-isabah.book-rights-matrix.v1" },
    "matrix_id": { "type": "string", "minLength": 1 },
    "work_id": { "const": "ibn-hajar-al-isabah" },
    "title": { "type": "string", "minLength": 1 },
    "source_editions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "edition",
          "publication_role",
          "rights_basis",
          "allowed_uses",
          "exclusions"
        ],
        "properties": {
          "source_id": { "type": "string", "minLength": 1 },
          "edition": { "type": "string", "minLength": 1 },
          "publication_role": {
            "enum": [
              "arabic-publication-base",
              "independent-public-domain-visual-witness",
              "private-reference-only"
            ]
          },
          "rights_basis": { "type": "string", "minLength": 1 },
          "source_revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "allowed_uses": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "exclusions": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "public_content_license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spdx", "url", "scope", "software_license_granted"],
      "properties": {
        "spdx": { "const": "CC-BY-NC-SA-4.0" },
        "url": { "const": "https://creativecommons.org/licenses/by-nc-sa/4.0/" },
        "scope": { "type": "string", "minLength": 1 },
        "software_license_granted": { "const": false }
      }
    },
    "attribution": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "exclusions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "publication_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["public_reading", "public_reuse", "canonical_promotion", "decision_issue"],
      "properties": {
        "public_reading": { "const": "approved-noncommercial-with-attribution-and-share-alike" },
        "public_reuse": { "const": "approved-under-cc-by-nc-sa-4.0" },
        "canonical_promotion": { "const": "separately-gated" },
        "decision_issue": { "type": "string", "format": "uri" }
      }
    },
    "reviewed_on": { "type": "string", "format": "date" },
    "follow_up_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "due_on", "triggers"],
      "properties": {
        "status": { "enum": ["required-on-change", "scheduled", "complete"] },
        "due_on": { "type": ["string", "null"], "format": "date" },
        "triggers": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
