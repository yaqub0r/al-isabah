{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["english_text", "names", "unresolved", "decisions"],
  "properties": {
    "english_text": {"type": "string", "minLength": 1},
    "names": {"type": "array", "items": {"$ref": "#/$defs/name"}},
    "unresolved": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["location", "issue", "best_rendering", "human_question"],
      "properties": {"location": {"type": "string"}, "issue": {"type": "string", "minLength": 1}, "best_rendering": {"type": "string"}, "human_question": {"type": "string"}}
    }},
    "decisions": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["issue", "resolution", "basis"],
      "properties": {"issue": {"type": "string"}, "resolution": {"type": "string"}, "basis": {"type": "string"}}
    }}
  },
  "$defs": {"name": {"type": "object", "additionalProperties": false, "required": ["arabic", "english", "kind"], "properties": {"arabic": {"type": "string", "minLength": 1}, "english": {"type": "string", "minLength": 1}, "kind": {"enum": ["person", "tribe", "place", "work", "other"]}}}}
}
