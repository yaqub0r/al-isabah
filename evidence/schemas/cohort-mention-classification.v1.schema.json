{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["items"],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["result_id", "decision", "relationship", "candidate_entry_numbers", "relevant_arabic", "rationale"],
        "properties": {
          "result_id": {"type": "string"},
          "decision": {
            "type": "string",
            "enum": [
              "covered_selected_entry",
              "covered_volume8",
              "include_context",
              "exclude_bare_relation",
              "exclude_other_person",
              "exclude_non_narrative"
            ]
          },
          "relationship": {"type": "string"},
          "candidate_entry_numbers": {"type": "array", "items": {"type": "integer"}},
          "relevant_arabic": {"type": "string"},
          "rationale": {"type": "string"}
        }
      }
    }
  }
}
