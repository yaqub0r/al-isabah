{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false, "required": ["verdict", "issues"],
  "properties": {
    "verdict": {"enum": ["pass", "revise", "witness_required"]},
    "issues": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["severity", "category", "location", "explanation", "suggested_fix", "witness_recommended"],
      "properties": {
        "severity": {"enum": ["minor", "major"]},
        "category": {"enum": ["omission", "addition", "meaning", "name", "number", "structure", "quotation", "poetry", "footnote", "ambiguity", "style"]},
        "location": {"type": "string"}, "explanation": {"type": "string", "minLength": 1},
        "suggested_fix": {"type": "string"}, "witness_recommended": {"type": "boolean"}
      }
    }}
  }
}
