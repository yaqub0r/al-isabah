{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://al-isabah.example/schemas/entry.v1.schema.json",
  "title": "Al-Isabah canonical entry v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "id", "work_id", "edition_id", "printed_entry_number",
    "title", "segments", "names", "unresolved", "translation", "provenance"
  ],
  "properties": {
    "schema": {"const": "al-isabah.entry.v1"},
    "id": {"pattern": "^isabah-entry-[0-9]{8}$"},
    "work_id": {"const": "ibn-hajar-al-isabah"},
    "edition_id": {"type": "string", "minLength": 1},
    "printed_entry_number": {"type": "integer", "minimum": 1},
    "title": {
      "type": "object",
      "required": ["english", "arabic_observed"],
      "properties": {
        "english": {"type": "string"},
        "arabic_observed": {"type": "string"}
      }
    },
    "segments": {"type": "array", "minItems": 1},
    "names": {"type": "array"},
    "unresolved": {"type": "array"},
    "translation": {
      "type": "object",
      "required": ["state", "machine_assessment", "human_review"],
      "properties": {
        "state": {"enum": ["untranslated", "draft", "translated"]},
        "machine_assessment": {"enum": ["pending", "passed", "needs_attention"]},
        "human_review": {"enum": ["unreviewed", "in_review", "reviewed", "verified", "disputed"]}
      }
    },
    "provenance": {"type": "object"}
  }
}

