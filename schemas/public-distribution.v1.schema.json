{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yaqub0r/al-isabah/schemas/public-distribution.v1.schema.json",
  "title": "Al-Isabah public-working distribution manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "distributionId",
    "publicationStatus",
    "canonicalPromotion",
    "work",
    "repository",
    "generatedAt",
    "packets",
    "authorities",
    "counts",
    "duplicatePrintedEntryNumbers",
    "files"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "distributionId": {
      "type": "string",
      "pattern": "^al-isabah-public-working-[a-f0-9]{12}$"
    },
    "publicationStatus": { "const": "public-working" },
    "canonicalPromotion": { "const": "blocked" },
    "work": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "titleArabic", "titleEnglish"],
      "properties": {
        "id": { "const": "ibn-hajar-al-isabah" },
        "titleArabic": { "type": "string", "minLength": 1 },
        "titleEnglish": { "type": "string", "minLength": 1 }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "commit"],
      "properties": {
        "url": { "const": "https://github.com/yaqub0r/al-isabah" },
        "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
      }
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "packets": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "object" }
    },
    "authorities": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "object" }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entries",
        "machinePassed",
        "needsAttention",
        "humanReviewed"
      ],
      "properties": {
        "entries": { "type": "integer", "minimum": 0 },
        "machinePassed": { "type": "integer", "minimum": 0 },
        "needsAttention": { "type": "integer", "minimum": 0 },
        "humanReviewed": { "type": "integer", "minimum": 0 }
      }
    },
    "duplicatePrintedEntryNumbers": {
      "type": "array",
      "items": { "type": "object" }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "bytes", "recordCount", "volume"],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^records/volume-[0-9]{2}\\.jsonl$"
          },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "bytes": { "type": "integer", "minimum": 1 },
          "recordCount": { "type": "integer", "minimum": 1 },
          "volume": { "type": "integer", "minimum": 1 }
        }
      }
    }
  }
}
