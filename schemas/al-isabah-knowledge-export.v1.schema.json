{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "al-isabah.knowledge-export.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "schemaVersion",
    "mode",
    "batchId",
    "snapshotSha256",
    "pins",
    "authority",
    "sourceRelease",
    "rights",
    "sourceScope",
    "selection",
    "coverage",
    "sourceRecords",
    "entities",
    "claims",
    "ambiguityGroups",
    "lifecycleEvents",
    "payloadSha256"
  ],
  "properties": {
    "schemaId": {
      "type": "string",
      "const": "al-isabah.knowledge-export.v1"
    },
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "mode": {
      "type": "string",
      "const": "synthetic"
    },
    "batchId": {
      "type": "string",
      "pattern": "urn:al-isabah:synthetic:batch:[A-Za-z0-9][A-Za-z0-9._-]{0,63}",
      "maxLength": 128
    },
    "snapshotSha256": {
      "type": "string",
      "pattern": "[0-9a-f]{64}"
    },
    "pins": {
      "$ref": "#/$defs/pins"
    },
    "authority": {
      "$ref": "#/$defs/authority"
    },
    "sourceRelease": {
      "$ref": "#/$defs/sourceRelease"
    },
    "rights": {
      "$ref": "#/$defs/rights"
    },
    "sourceScope": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sourceScopeItem"
      },
      "uniqueItems": true,
      "minItems": 1,
      "maxItems": 10000
    },
    "selection": {
      "$ref": "#/$defs/selection"
    },
    "coverage": {
      "$ref": "#/$defs/coverage"
    },
    "sourceRecords": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sourceRecord"
      },
      "uniqueItems": true,
      "minItems": 1,
      "maxItems": 10000
    },
    "entities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entity"
      },
      "uniqueItems": true,
      "minItems": 0,
      "maxItems": 10000
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      },
      "uniqueItems": true,
      "minItems": 0,
      "maxItems": 10000
    },
    "ambiguityGroups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ambiguityGroup"
      },
      "uniqueItems": true,
      "minItems": 0,
      "maxItems": 10000
    },
    "lifecycleEvents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/lifecycleEvent"
      },
      "uniqueItems": true,
      "minItems": 0,
      "maxItems": 10000
    },
    "payloadSha256": {
      "type": "string",
      "pattern": "[0-9a-f]{64}"
    }
  },
  "$defs": {
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorityId",
        "workId",
        "editionId",
        "revisionId",
        "sourceArtifactSha256"
      ],
      "properties": {
        "authorityId": {
          "type": "string",
          "pattern": "urn:al-isabah:synthetic:authority:[A-Za-z0-9][A-Za-z0-9._-]{0,63}",
          "maxLength": 128
        },
        "workId": {
          "type": "string",
          "pattern": "urn:al-isabah:synthetic:work:[A-Za-z0-9][A-Za-z0-9._-]{0,63}",
          "maxLength": 128
        },
        "editionId": {
          "type": "string",
          "pattern": "urn:al-isabah:synthetic:edition:[A-Za-z0-9][A-Za-z0-9._-]{0,63}",
          "maxLength": 128
        },
        "revisionId": {
          "type": "string",
          "pattern": "urn:al-isabah:synthetic:revision:[A-Za-z0-9][A-Za-z0-9._-]{0,63}",
          "maxLength": 128
        },
        "sourceArtifactSha256": {
          "type": "string",
          "pattern": "[0-9a-f]{64}"
        }
      }
    },
    "sourceRelease": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "repository",
        "repositoryCommit",
        "releaseTag",
        "distributionSchemaVersion",
        "assetSha256",
        "proposalId",
        "proposalSha256",
        "closureId",
        "closureSha256",
        "publicationStatus"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "urn:al-isabah:synthetic:release:[A-Za-z0-9][A-Za-z0-9._-]{0,63}",
          "maxLength": 128
        },
        "repository": {
          "type": "string",
          "const": "https://github.com/yaqub0r/al-isabah"
        },
        "repositoryCommit": {
          "type": "string",
          "pattern": "[0-9a-f]{40}"
        },
        "releaseTag": {
          "type": "string",
          "pattern": "synthetic-[0-9a-f]{40}"
        },
        "distributionSchemaVersion": {
          "type": "string",
          "const": "2.0.0"
        },
        "assetSha256": {
          "type": "string",
          "pattern": "[0-9a-f]{64}"
        },
        "proposalId": {
          "type": "string",
          "pattern": "urn:al-isabah:synthetic:proposal:[A-Za-z0-9][A-Za-z0-9._-]{0,63}",
          "maxLength": 128
        },
        "proposalSha256": {
          "type": "string",
          "pattern": "[0-9a-f]{64}"
        },
        "closureId": {
          "type": "string",
          "pattern": "urn:al-isabah:synthetic:closure:[A-Za-z0-9][A-Za-z0-9._-]{0,63}",
          "maxLength": 128
        },
        "closureSha256": {
          "type": "string",
          "pattern": "[0-9a-f]{64}"
        },
        "publicationStatus": {
          "type": "string",
          "const": "synthetic"
        }
      }
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "licenseId",
        "useClassification",
        "attributionIds",
        "commercialUse",
        "redistribution",
        "softwareLicenseGranted"
      ],
      "properties": {
        "licenseId": {
          "type": "string",
          "const": "synthetic-no-real-content-license"
        },
        "useClassification": {
          "type": "string",
          "const": "synthetic-testing-only"
        },
        "attributionIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "urn:al-isabah:synthetic:attribution:[A-Za-z0-9][A-Za-z0-9._-]{0,63}",
            "maxLength": 128
          },
          "uniqueItems": true,
          "minItems": 1,
          "maxItems": 10000
        },
        "commercialUse": {
          "type": "string",
          "const": "not-granted"
        },
        "redistribution": {
          "type": "string",
          "const": "synthetic-fixtures-only"
        },
        "softwareLicenseGranted": {
          "const": false,
          "type": "boolean"
        }
      }
    },
    "sourceScopeItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "volume",
        "recordCount"
      ],
      "properties": {
        "volume": {
          "type": "integer",
          "minimum": 1
        },
        "recordCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "sourceRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "logicalRecordId",
        "sourceReleaseId",
        "recordSha256",
        "authorityUnitSha256",
        "volume",
        "pages",
        "sourceOrdinal",
        "printedEntryNumber",
        "machineAssessment",
        "humanReview",
        "canonicalPromotion",
        "extractionStatus"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "urn:al-isabah:synthetic:record:[A-Za-z0-9][A-Za-z0-9._-]{0,63}",
          "maxLength": 128
        },
        "logicalRecordId": {
          "type": "string",
          "pattern": "urn:al-isabah:synthetic:logical-record:[A-Za-z0-9][A-Za-z0-9._-]{0,63}",
          "maxLength": 128
        },
        "sourceReleaseId": {
          "type": "string",
          "pattern": "urn:al-isabah:synthetic:release:[A-Za-z0-9][A-Za-z0-9._-]{0,63}",
          "maxLength": 128
        },
        "recordSha256": {
          "type": "string",
          "pattern": "[0-9a-f]{64}"
        },
        "authorityUnitSha256": {
          "type": "string",
          "pattern": "[0-9a-f]{64}"
        },
        "volume": {
          "type": "integer",
          "minimum": 1
        },
        "pages": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "uniqueItems": true,
          "minItems": 1,
          "maxItems": 10000
        },
        "sourceOrdinal": {
          "type": "integer",
          "minimum": 1
        },
        "printedEntryNumber": {
          "type": "integer",
          "minimum": 1
        },
        "machineAssessment": {
          "type": "string",
          "enum": [
            "passed",
            "needs_attention"
          ]
        },
        "humanReview": {
          "type": "string",
          "enum": [
            "unreviewed",
            "reviewed",
            "verified"
          ]
        },
        "canonicalPromotion": {
          "type": "string",
          "enum": [
            "blocked",
            "not_promoted",
            "promoted"
          ]
        },
        "extractionStatus": {
          "type": "string",
          "enum": [
            "not_started",
            "partial",
            "complete"
          ]
        }
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sourceRecordIds"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "urn:al-isabah:synthetic:entity:[A-Za-z0-9][A-Za-z0-9._-]{0,63}",
          "maxLength": 128
        },
        "sourceRecordIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "urn:al-isabah:synthetic:record:[A-Za-z0-9][A-Za-z0-9._-]{0,63}",
            "maxLength": 128
          },
          "uniqueItems": true,
          "minItems": 1,
          "maxItems": 10000
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "subjectId",
        "predicateId",
        "objectId",
        "assertionClass",
        "sourceRecordIds",
        "sourceCriticalStatus",
        "evidentiaryStrength",
        "transmissionStrength",
        "storyUseTier",
        "attributionRequired",
        "ambiguityGroupIds"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "urn:al-isabah:synthetic:claim:[A-Za-z0-9][A-Za-z0-9._-]{0,63}",
          "maxLength": 128
        },
        "subjectId": {
          "type": "string",
          "pattern": "urn:al-isabah:synthetic:entity:[A-Za-z0-9][A-Za-z0-9._-]{0,63}",
          "maxLength": 128
        },
        "predicateId": {
          "type": "string",
          "pattern": "urn:al-isabah:synthetic:predicate:[A-Za-z0-9][A-Za-z0-9._-]{0,63}",
          "maxLength": 128
        },
        "objectId": {
          "type": "string",
          "pattern": "urn:al-isabah:synthetic:entity:[A-Za-z0-9][A-Za-z0-9._-]{0,63}",
          "maxLength": 128
        },
        "assertionClass": {
          "type": "string",
          "enum": [
            "source_attested",
            "editorial_inference"
          ]
        },
        "sourceRecordIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "urn:al-isabah:synthetic:record:[A-Za-z0-9][A-Za-z0-9._-]{0,63}",
            "maxLength": 128
          },
          "uniqueItems": true,
          "minItems": 1,
          "maxItems": 10000
        },
        "sourceCriticalStatus": {
          "type": "string",
          "enum": [
            "unqualified",
            "qualified",
            "disputed",
            "rejected",
            "unassessed"
          ]
        },
        "evidentiaryStrength": {
          "type": "string",
          "enum": [
            "source_supported",
            "qualified",
            "unassessed"
          ]
        },
        "transmissionStrength": {
          "type": "string",
          "enum": [
            "unassessed",
            "supported",
            "criticized",
            "mixed"
          ]
        },
        "storyUseTier": {
          "type": "string",
          "enum": [
            "factual_spine",
            "qualified_context",
            "attributed_disputed_report",
            "not_suitable_for_story"
          ]
        },
        "attributionRequired": {
          "type": "boolean"
        },
        "ambiguityGroupIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "urn:al-isabah:synthetic:group:[A-Za-z0-9][A-Za-z0-9._-]{0,63}",
            "maxLength": 128
          },
          "uniqueItems": true,
          "minItems": 0,
          "maxItems": 10000
        }
      }
    },
    "ambiguityGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "memberClaimIds",
        "resolutionStatus",
        "presentationMode"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "urn:al-isabah:synthetic:group:[A-Za-z0-9][A-Za-z0-9._-]{0,63}",
          "maxLength": 128
        },
        "memberClaimIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "urn:al-isabah:synthetic:claim:[A-Za-z0-9][A-Za-z0-9._-]{0,63}",
            "maxLength": 128
          },
          "uniqueItems": true,
          "minItems": 2,
          "maxItems": 10000
        },
        "resolutionStatus": {
          "type": "string",
          "const": "unresolved"
        },
        "presentationMode": {
          "type": "string",
          "enum": [
            "parallel_attributed_reports",
            "qualified_ambiguity_context"
          ]
        }
      }
    },
    "lifecycleEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "targetClaimId",
        "replacementClaimIds"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "urn:al-isabah:synthetic:event:[A-Za-z0-9][A-Za-z0-9._-]{0,63}",
          "maxLength": 128
        },
        "kind": {
          "type": "string",
          "enum": [
            "corrects",
            "supersedes",
            "withdraws"
          ]
        },
        "targetClaimId": {
          "type": "string",
          "pattern": "urn:al-isabah:synthetic:claim:[A-Za-z0-9][A-Za-z0-9._-]{0,63}",
          "maxLength": 128
        },
        "replacementClaimIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "urn:al-isabah:synthetic:claim:[A-Za-z0-9][A-Za-z0-9._-]{0,63}",
            "maxLength": 128
          },
          "uniqueItems": true,
          "minItems": 0,
          "maxItems": 10000
        }
      }
    },
    "batchDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "recordIds",
        "volumes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "urn:al-isabah:synthetic:batch:[A-Za-z0-9][A-Za-z0-9._-]{0,63}",
          "maxLength": 128
        },
        "recordIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "urn:al-isabah:synthetic:record:[A-Za-z0-9][A-Za-z0-9._-]{0,63}",
            "maxLength": 128
          },
          "uniqueItems": true,
          "minItems": 1,
          "maxItems": 10000
        },
        "volumes": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "uniqueItems": true,
          "minItems": 1,
          "maxItems": 10000
        }
      }
    },
    "pins": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaSha256",
        "policySha256",
        "admissionSha256",
        "rightsSha256",
        "sourceReleaseSha256"
      ],
      "properties": {
        "schemaSha256": {
          "type": "string",
          "pattern": "[0-9a-f]{64}"
        },
        "policySha256": {
          "type": "string",
          "pattern": "[0-9a-f]{64}"
        },
        "admissionSha256": {
          "type": "string",
          "pattern": "[0-9a-f]{64}"
        },
        "rightsSha256": {
          "type": "string",
          "pattern": "[0-9a-f]{64}"
        },
        "sourceReleaseSha256": {
          "type": "string",
          "pattern": "[0-9a-f]{64}"
        }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requestedRecordIds",
        "dependencyRecordIds",
        "requestedClaimIds",
        "dependencyClaimIds",
        "volumes"
      ],
      "properties": {
        "requestedRecordIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "urn:al-isabah:synthetic:record:[A-Za-z0-9][A-Za-z0-9._-]{0,63}",
            "maxLength": 128
          },
          "uniqueItems": true,
          "minItems": 1,
          "maxItems": 10000
        },
        "dependencyRecordIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "urn:al-isabah:synthetic:record:[A-Za-z0-9][A-Za-z0-9._-]{0,63}",
            "maxLength": 128
          },
          "uniqueItems": true,
          "minItems": 0,
          "maxItems": 10000
        },
        "requestedClaimIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "urn:al-isabah:synthetic:claim:[A-Za-z0-9][A-Za-z0-9._-]{0,63}",
            "maxLength": 128
          },
          "uniqueItems": true,
          "minItems": 0,
          "maxItems": 10000
        },
        "dependencyClaimIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "urn:al-isabah:synthetic:claim:[A-Za-z0-9][A-Za-z0-9._-]{0,63}",
            "maxLength": 128
          },
          "uniqueItems": true,
          "minItems": 0,
          "maxItems": 10000
        },
        "volumes": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "uniqueItems": true,
          "minItems": 1,
          "maxItems": 10000
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceScopeRecordCount",
        "approvedSourceRecordCount",
        "semanticExtractedRecordCount",
        "semanticCompleteRecordCount",
        "approvedClaimCount",
        "requestedRecordCount",
        "dependencyRecordCount",
        "totalRecordCount",
        "requestedClaimCount",
        "dependencyClaimCount",
        "totalClaimCount"
      ],
      "properties": {
        "sourceScopeRecordCount": {
          "type": "integer",
          "minimum": 0
        },
        "approvedSourceRecordCount": {
          "type": "integer",
          "minimum": 0
        },
        "semanticExtractedRecordCount": {
          "type": "integer",
          "minimum": 0
        },
        "semanticCompleteRecordCount": {
          "type": "integer",
          "minimum": 0
        },
        "approvedClaimCount": {
          "type": "integer",
          "minimum": 0
        },
        "requestedRecordCount": {
          "type": "integer",
          "minimum": 0
        },
        "dependencyRecordCount": {
          "type": "integer",
          "minimum": 0
        },
        "totalRecordCount": {
          "type": "integer",
          "minimum": 0
        },
        "requestedClaimCount": {
          "type": "integer",
          "minimum": 0
        },
        "dependencyClaimCount": {
          "type": "integer",
          "minimum": 0
        },
        "totalClaimCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "predicateIds",
        "humanReviewEffect",
        "consumerPromotion",
        "predicateSemantics"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "urn:al-isabah:synthetic:policy:[A-Za-z0-9][A-Za-z0-9._-]{0,63}",
          "maxLength": 128
        },
        "predicateIds": {
          "type": "array",
          "items": {
            "type": "string",
            "const": "urn:al-isabah:synthetic:predicate:related-to"
          },
          "uniqueItems": true,
          "minItems": 1,
          "maxItems": 10000
        },
        "humanReviewEffect": {
          "type": "string",
          "const": "metadata-only"
        },
        "consumerPromotion": {
          "type": "string",
          "const": "separate-policy"
        },
        "predicateSemantics": {
          "type": "string",
          "const": "synthetic-directed-relation-no-historical-meaning"
        }
      }
    },
    "admission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "decision",
        "approvedCollectionsSha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "urn:al-isabah:synthetic:admission:[A-Za-z0-9][A-Za-z0-9._-]{0,63}",
          "maxLength": 128
        },
        "decision": {
          "type": "string",
          "const": "synthetic-test-only"
        },
        "approvedCollectionsSha256": {
          "type": "string",
          "pattern": "[0-9a-f]{64}"
        }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaId",
        "schemaVersion",
        "mode",
        "authority",
        "sourceRelease",
        "rights",
        "sourceScope",
        "policy",
        "admission",
        "batches",
        "sourceRecords",
        "entities",
        "claims",
        "ambiguityGroups",
        "lifecycleEvents"
      ],
      "properties": {
        "schemaId": {
          "type": "string",
          "const": "al-isabah.knowledge-snapshot.v1"
        },
        "schemaVersion": {
          "type": "string",
          "const": "1.0.0"
        },
        "mode": {
          "type": "string",
          "const": "synthetic"
        },
        "authority": {
          "$ref": "#/$defs/authority"
        },
        "sourceRelease": {
