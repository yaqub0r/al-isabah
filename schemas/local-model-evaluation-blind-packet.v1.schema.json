{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yaqub0r/al-isabah/schemas/local-model-evaluation-blind-packet.v1.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "reviewPacketId", "evaluationId", "policySha256", "casesSha256", "seedSha256", "reviewState", "runArtifactSha256", "cases"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"}, "reviewPacketId": {"type": "string", "pattern": "^eval-review-packet-[a-f0-9]{16}$"},
    "evaluationId": {"type": "string"}, "policySha256": {"type": "string"}, "casesSha256": {"type": "string"}, "seedSha256": {"type": "string"},
    "reviewState": {"const": "blind-unreviewed"}, "runArtifactSha256": {"type": "array", "minItems": 2, "maxItems": 26, "uniqueItems": true, "items": {"type": "string"}},
    "cases": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false,
      "required": ["caseId", "arabic", "arabicSha256", "candidates"],
      "properties": {"caseId": {"type": "string"}, "arabic": {"type": "string"}, "arabicSha256": {"type": "string"},
        "candidates": {"type": "array", "minItems": 2, "maxItems": 26, "items": {"type": "object", "additionalProperties": false,
          "required": ["alias", "titleEnglish", "bodyEnglish", "issues"],
          "properties": {"alias": {"type": "string", "pattern": "^[A-Z]$"}, "titleEnglish": {"type": "string"}, "bodyEnglish": {"type": "string"}, "issues": {"type": "array", "items": {"type": "string"}}}
        }}
      }
    }}
  }
}
