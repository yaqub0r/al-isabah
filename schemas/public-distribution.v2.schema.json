{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yaqub0r/al-isabah/schemas/public-distribution.v2.schema.json",
  "title": "Al-Isabah public-working distribution manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "distributionId",
    "publicationStatus",
    "canonicalPromotion",
    "work",
    "repository",
    "generatedAt",
    "rights",
    "packets",
    "authorities",
    "counts",
    "duplicatePrintedEntryNumbers",
    "files"
  ],
  "properties": {
    "schemaVersion": { "const": "2.0.0" },
    "distributionId": {
      "type": "string",
      "pattern": "^al-isabah-public-working-[a-f0-9]{12}$"
    },
    "publicationStatus": { "const": "public-working" },
    "canonicalPromotion": { "const": "blocked" },
    "work": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "titleArabic", "titleEnglish"],
      "properties": {
        "id": { "const": "ibn-hajar-al-isabah" },
        "titleArabic": { "type": "string", "minLength": 1 },
        "titleEnglish": { "type": "string", "minLength": 1 }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "commit"],
      "properties": {
        "url": { "const": "https://github.com/yaqub0r/al-isabah" },
        "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
      }
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["matrixId", "license", "softwareLicenseGranted", "attribution", "excludedMaterial"],
      "properties": {
        "matrixId": { "type": "string", "minLength": 1 },
        "license": {
          "type": "object",
          "additionalProperties": false,
          "required": ["spdx", "url"],
          "properties": {
            "spdx": { "const": "CC-BY-NC-SA-4.0" },
            "url": { "const": "https://creativecommons.org/licenses/by-nc-sa/4.0/" }
          }
        },
        "softwareLicenseGranted": { "const": false },
        "attribution": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "excludedMaterial": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "packets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["packetId", "sha256", "entryCount"],
        "properties": {
          "packetId": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "entryCount": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "authorities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sourceId", "commit", "sha256", "license"],
        "properties": {
          "sourceId": { "type": "string", "minLength": 1 },
          "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "license": {
            "type": "object",
            "required": ["spdx", "url", "attribution"],
            "properties": {
              "spdx": { "const": "CC-BY-NC-SA-4.0" },
              "url": { "const": "https://creativecommons.org/licenses/by-nc-sa/4.0/" },
              "attribution": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entries",
        "machinePassed",
        "needsAttention",
        "humanReviewed"
      ],
      "properties": {
        "entries": { "type": "integer", "minimum": 0 },
        "machinePassed": { "type": "integer", "minimum": 0 },
        "needsAttention": { "type": "integer", "minimum": 0 },
        "humanReviewed": { "type": "integer", "minimum": 0 }
      }
    },
    "duplicatePrintedEntryNumbers": {
      "type": "array",
      "items": { "type": "object" }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "bytes", "recordCount", "volume"],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^records/volume-[0-9]{2}\\.jsonl$"
          },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "bytes": { "type": "integer", "minimum": 1 },
          "recordCount": { "type": "integer", "minimum": 1 },
          "volume": { "type": "integer", "minimum": 1 }
        }
      }
    }
  }
}
