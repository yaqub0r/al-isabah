{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yaqub0r/al-isabah/schemas/local-model-evaluation-run.v1.schema.json",
  "title": "Al-Isabah public local-model run v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "packetId", "packetSha256", "evaluationId", "issue", "policy", "policySha256", "casesSha256", "config", "configSha256", "generatedAt", "resourceOutcome", "outputs", "reviewStatus", "roleStatus", "promotionStatus"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"}, "runId": {"type": "string", "pattern": "^eval-run-[a-f0-9]{16}$"},
    "packetId": {"type": "string", "pattern": "^eval-packet-[a-f0-9]{16}$"}, "packetSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "evaluationId": {"const": "al-isabah-local-model-v1"}, "issue": {"const": "https://github.com/yaqub0r/al-isabah/issues/49"},
    "policy": {
      "type": "object", "additionalProperties": false,
      "required": ["bindingPath", "bindingSha256", "evaluationProtocolPath", "evaluationProtocolSha256", "glossaryPath", "glossarySha256", "promptPath", "promptSha256"],
      "properties": {
        "bindingPath": {"type": "string"}, "bindingSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "evaluationProtocolPath": {"type": "string"}, "evaluationProtocolSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "glossaryPath": {"type": "string"}, "glossarySha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "promptPath": {"type": "string"}, "promptSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "policySha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "casesSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "config": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "configId", "role", "engine", "runtimeVersion", "model", "modelDigest", "artifactDisclosure", "quantization", "houseProfile", "nativeThinkingRequested", "nativeThinkingObserved", "contextTokens", "maxOutputTokens", "temperature", "samplingSeed", "promptVersion", "promptSha256"],
      "properties": {
        "schemaVersion": {"const": "1.0.0"}, "configId": {"type": "string", "minLength": 1}, "role": {"type": "string"},
        "engine": {"type": "string"}, "runtimeVersion": {"type": "string"}, "model": {"type": "string", "minLength": 1},
        "modelDigest": {"type": ["string", "null"]}, "artifactDisclosure": {"type": "string"}, "quantization": {"type": "string"},
        "houseProfile": {"type": "string"}, "nativeThinkingRequested": {"type": "boolean"}, "nativeThinkingObserved": {"type": ["boolean", "null"]},
        "contextTokens": {"type": ["integer", "null"]}, "maxOutputTokens": {"type": ["integer", "null"]}, "temperature": {"type": ["number", "null"]},
        "samplingSeed": {"type": ["integer", "string", "null"]}, "promptVersion": {"type": "string"}, "promptSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "configSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "generatedAt": {"type": "string", "format": "date-time"},
    "resourceOutcome": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "profile", "limitations"],
      "properties": {"status": {"enum": ["completed", "failed", "partial"]}, "profile": {"type": "string", "minLength": 1}, "limitations": {"type": "array", "items": {"type": "string"}}}
    },
    "outputs": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["caseId", "titleEnglish", "titleEnglishSha256", "bodyEnglish", "bodyEnglishSha256", "issues", "publicSafety"],
      "properties": {
        "caseId": {"type": "string", "pattern": "^case-[0-9]{3}$"}, "titleEnglish": {"type": "string", "minLength": 1},
        "titleEnglishSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "bodyEnglish": {"type": "string", "minLength": 1},
        "bodyEnglishSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "issues": {"type": "array", "items": {"type": "string"}},
        "publicSafety": {"type": "object", "additionalProperties": false, "required": ["status", "provenance", "admittedBy"], "properties": {"status": {"const": "admitted"}, "provenance": {"const": "sanitized-final-model-output"}, "admittedBy": {"type": "string", "minLength": 1}}}
      }
    }},
    "reviewStatus": {"const": "unreviewed"}, "roleStatus": {"const": "no-role"}, "promotionStatus": {"const": "blocked"}
  }
}
