{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yaqub0r/al-isabah/blob/main/schemas/translation-governance-reference.v6.schema.json",
  "title": "Al-Isabah translation governance reference v6",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "referenceVersion",
    "supersedes",
    "authority",
    "integrity",
    "governanceArtifacts",
    "releaseSemantics",
    "consumerBoundary",
    "deprecatedConsumerAuthorities",
    "executionSemantics"
  ],
  "properties": {
    "schema": {
      "const": "al-isabah.translation-governance-reference.v6"
    },
    "referenceVersion": {
      "const": "6.0.0"
    },
    "supersedes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "referenceVersion",
        "sha256"
      ],
      "properties": {
        "path": {
          "const": "docs/contracts/translation-governance-reference.v5.json"
        },
        "referenceVersion": {
          "const": "5.0.0"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "repositoryPath",
        "requiredPin"
      ],
      "properties": {
        "repository": {
          "const": "https://github.com/yaqub0r/al-isabah"
        },
        "repositoryPath": {
          "const": "docs/contracts/translation-governance-reference.v6.json"
        },
        "requiredPin": {
          "const": "immutable-repository-commit"
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "textNormalization"
      ],
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "textNormalization": {
          "const": "utf-8-lf"
        }
      }
    },
    "governanceArtifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "sha256",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "status": {
            "enum": [
              "active",
              "reference",
              "rollback-only"
            ]
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          }
        }
      }
    },
    "releaseSemantics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agentCompletionScope",
        "agentCompletionIndependentOfHumanReview",
        "humanReviewScope",
        "humanReviewManagementState",
        "humanReviewDisclosureRequired",
        "humanReviewAffectsEligibility",
        "humanReviewChangesReleaseClass",
        "substantiveDefectsAffectEligibility",
        "promotionEligibilityControls",
        "immutableCycleChangeKinds",
        "correctionMode"
      ],
      "properties": {
        "agentCompletionScope": {
          "const": "locked-volume-or-cohort-revision"
        },
        "agentCompletionIndependentOfHumanReview": {
          "const": true
        },
        "humanReviewScope": {
          "const": "append-only-per-record-metadata-and-confidence"
        },
        "humanReviewManagementState": {
          "const": "ongoing-nonterminal"
        },
        "humanReviewDisclosureRequired": {
          "const": true
        },
        "humanReviewAffectsEligibility": {
          "const": false
        },
        "humanReviewChangesReleaseClass": {
          "const": false
        },
        "substantiveDefectsAffectEligibility": {
          "const": true
        },
        "promotionEligibilityControls": {
          "const": [
            "source-binding",
            "provenance-binding",
            "rights-eligibility",
            "public-output-boundary",
            "deterministic-validation",
            "substantive-eligibility",
            "unresolved-state-disclosure"
          ]
        },
        "immutableCycleChangeKinds": {
          "const": [
            "incremental-translation",
            "correction",
            "review-coverage"
          ]
        },
        "correctionMode": {
          "const": "new-immutable-release-with-supersession"
        }
      }
    },
    "consumerBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed",
        "prohibited"
      ],
      "properties": {
        "allowed": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "prohibited": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "deprecatedConsumerAuthorities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "consumerRepository",
          "path",
          "kind",
          "replacement"
        ],
        "properties": {
          "consumerRepository": {
            "type": "string",
            "format": "uri"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "selector": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "replacement": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "executionSemantics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "methodSelection",
        "configurationOrigin",
        "runtimeBinding",
        "workerSelfReportSufficient",
        "approvalIsEmpiricalProof",
        "evaluationHistory",
        "historicalValidation",
        "packetSchemaVersion",
        "stageProvenanceVersion",
        "entryShardSchemaVersion",
        "structuralShardSchemaVersion",
        "trustModel",
        "signingKeyRequired",
        "launchConfiguration"
      ],
      "properties": {
        "scope": {
          "type": "string",
          "const": "new-production-semantic-stages"
        },
        "methodSelection": {
          "type": "string",
          "const": "exact-active-stage-specific-method-id"
        },
        "configurationOrigin": {
          "type": "string",
          "const": "explicit-only"
        },
        "runtimeBinding": {
          "type": "string",
          "const": "explicit-launch-and-captured-host-settings-bound-to-checkpoint"
        },
        "workerSelfReportSufficient": {
          "type": "boolean",
          "const": false
        },
        "approvalIsEmpiricalProof": {
          "type": "boolean",
          "const": false
        },
        "evaluationHistory": {
          "type": "string",
          "const": "append-only-with-hash-bound-supersession"
        },
        "historicalValidation": {
          "type": "string",
          "const": "original-immutable-governance-pin"
        },
        "packetSchemaVersion": {
          "type": "string",
          "const": "3.0.0"
        },
        "stageProvenanceVersion": {
          "type": "string",
          "const": "3.0.0"
        },
        "entryShardSchemaVersion": {
          "type": "string",
          "const": "3.0.0"
        },
        "structuralShardSchemaVersion": {
          "type": "string",
          "const": "3.1.0"
        },
        "trustModel": {
          "type": "string",
          "const": "trusted-local-host-not-malicious-editor-proof"
        },
        "signingKeyRequired": {
          "type": "boolean",
          "const": false
        },
        "launchConfiguration": {
          "type": "string",
          "const": "explicit-production-task-and-every-semantic-worker"
        }
      }
    }
  }
}
