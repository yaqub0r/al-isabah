{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yaqub0r/al-isabah/schemas/entry-title-decisions.v1.schema.json",
  "title": "Al-Isabah entry-title decisions",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contractId", "workId", "status", "sourceAuthority", "decisions"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "contractId": { "const": "al-isabah-entry-title-structure" },
    "workId": { "const": "ibn-hajar-al-isabah" },
    "status": { "const": "active" },
    "sourceAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "artifact", "license"],
      "properties": {
        "repository": { "type": "string", "format": "uri" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "artifact": { "type": "string", "minLength": 1 },
        "license": { "type": "string", "minLength": 1 }
      }
    },
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sourceEntryNumber", "role", "title", "bodyOpeningKind", "bodyOpening"],
        "properties": {
          "sourceEntryNumber": { "type": "integer", "minimum": 1 },
          "role": { "enum": ["positive-reference", "corrective", "typography-reference"] },
          "title": { "$ref": "#/$defs/bilingualText" },
          "bodyOpeningKind": { "enum": ["lineage", "prose"] },
          "bodyOpening": { "$ref": "#/$defs/bilingualText" }
        }
      }
    }
  },
  "$defs": {
    "bilingualText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ar", "en"],
      "properties": {
        "ar": { "type": "string", "minLength": 1 },
        "en": { "type": "string", "minLength": 1 }
      }
    }
  }
}
