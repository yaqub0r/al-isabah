{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yaqub0r/al-isabah/schemas/entry-title-decisions.v3.schema.json",
  "title": "Al-Isabah entry-title decisions with source-unit identity",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contractId", "workId", "status", "sourceAuthority", "decisions"],
  "properties": {
    "schemaVersion": {"const": "1.3.0"},
    "contractId": {"const": "al-isabah-entry-title-structure"},
    "workId": {"const": "ibn-hajar-al-isabah"},
    "status": {"const": "active"},
    "sourceAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "artifact", "license"],
      "properties": {
        "repository": {"type": "string", "format": "uri"},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "artifact": {"type": "string", "minLength": 1},
        "license": {"type": "string", "minLength": 1}
      }
    },
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "anyOf": [
          {"$ref": "#/$defs/legacyOrdinaryDecision"},
          {"$ref": "#/$defs/legacyTitleOnlyDecision"},
          {"$ref": "#/$defs/sourceBoundOrdinaryDecision"},
          {"$ref": "#/$defs/sourceBoundTitleOnlyDecision"}
        ]
      }
    }
  },
  "$defs": {
    "bilingualText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ar", "en"],
      "properties": {
        "ar": {"type": "string", "minLength": 1},
        "en": {"type": "string", "minLength": 1}
      }
    },
    "emptyBilingualText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ar", "en"],
      "properties": {
        "ar": {"const": ""},
        "en": {"const": ""}
      }
    },
    "shared": {
      "sourceEntryNumber": {"type": "integer", "minimum": 1},
      "sourceUnitId": {"type": "string", "pattern": "^openiti-5835c183-unit-[0-9]{6}$"},
      "sourceHash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
      "role": {"enum": ["positive-reference", "corrective", "typography-reference"]},
      "editorialSupply": {"type": "object"}
    },
    "legacyOrdinaryDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceEntryNumber", "role", "title", "bodyOpeningKind", "bodyOpening"],
      "properties": {
        "sourceEntryNumber": {"$ref": "#/$defs/shared/sourceEntryNumber"},
        "role": {"$ref": "#/$defs/shared/role"},
        "title": {"$ref": "#/$defs/bilingualText"},
        "bodyOpeningKind": {"enum": ["lineage", "prose"]},
        "bodyOpening": {"$ref": "#/$defs/bilingualText"},
        "editorialSupply": {"$ref": "#/$defs/shared/editorialSupply"}
      }
    },
    "legacyTitleOnlyDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceEntryNumber", "role", "title", "bodyOpeningKind", "bodyOpening", "sourceUnitSha256"],
      "properties": {
        "sourceEntryNumber": {"$ref": "#/$defs/shared/sourceEntryNumber"},
        "role": {"$ref": "#/$defs/shared/role"},
        "title": {"$ref": "#/$defs/bilingualText"},
        "bodyOpeningKind": {"const": "none"},
        "bodyOpening": {"$ref": "#/$defs/emptyBilingualText"},
        "sourceUnitSha256": {"$ref": "#/$defs/shared/sourceHash"}
      }
    },
    "sourceBoundOrdinaryDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceEntryNumber", "sourceUnitId", "sourceRawSha256", "role", "title", "bodyOpeningKind", "bodyOpening"],
      "properties": {
        "sourceEntryNumber": {"$ref": "#/$defs/shared/sourceEntryNumber"},
        "sourceUnitId": {"$ref": "#/$defs/shared/sourceUnitId"},
        "sourceRawSha256": {"$ref": "#/$defs/shared/sourceHash"},
        "role": {"$ref": "#/$defs/shared/role"},
        "title": {"$ref": "#/$defs/bilingualText"},
        "bodyOpeningKind": {"enum": ["lineage", "prose"]},
        "bodyOpening": {"$ref": "#/$defs/bilingualText"},
        "editorialSupply": {"$ref": "#/$defs/shared/editorialSupply"}
      }
    },
    "sourceBoundTitleOnlyDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceEntryNumber", "sourceUnitId", "sourceRawSha256", "role", "title", "bodyOpeningKind", "bodyOpening"],
      "properties": {
        "sourceEntryNumber": {"$ref": "#/$defs/shared/sourceEntryNumber"},
        "sourceUnitId": {"$ref": "#/$defs/shared/sourceUnitId"},
        "sourceRawSha256": {"$ref": "#/$defs/shared/sourceHash"},
        "role": {"$ref": "#/$defs/shared/role"},
        "title": {"$ref": "#/$defs/bilingualText"},
        "bodyOpeningKind": {"const": "none"},
        "bodyOpening": {"$ref": "#/$defs/emptyBilingualText"}
      }
    }
  }
}
