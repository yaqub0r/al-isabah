{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yaqub0r/al-isabah/blob/main/schemas/honorific-formula-registry.v1.schema.json",
  "title": "Al-Isabah honorific formula registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "registryVersion", "contractId", "profileId", "entries"],
  "properties": {
    "schema": { "const": "al-isabah.honorific-formula-registry.v1" },
    "registryVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "contractId": { "const": "translation-quality-workflow" },
    "profileId": { "const": "al-isabah-translation-profile" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "target",
          "semanticClass",
          "referentScope",
          "grammaticalAgreement",
          "expandedArabic",
          "accessibleEnglish"
        ],
        "properties": {
          "source": { "type": "string", "minLength": 1 },
          "target": { "type": "string", "minLength": 1 },
          "semanticClass": { "type": "string", "minLength": 1 },
          "referentScope": { "type": "string", "minLength": 1 },
          "grammaticalAgreement": { "type": "string", "minLength": 1 },
          "expandedArabic": { "type": "string", "minLength": 1 },
          "accessibleEnglish": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
