{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:al-isabah:knowledge-record-accounting:v1",
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ref": {"type": "object", "additionalProperties": false, "required": ["kind", "id"], "properties": {"kind": {"enum": ["claims", "events", "reports", "values"]}, "id": {"type": "string", "minLength": 1}}},
    "atom": {"type": "object", "additionalProperties": false, "required": ["id", "sourceSpanId", "startChar", "endChar", "surfaceSha256", "kind", "disposition", "objectRefs", "findingIds", "reasonCode", "rationale"], "properties": {"id": {"type": "string", "minLength": 1}, "sourceSpanId": {"type": "string", "minLength": 1}, "startChar": {"type": "integer", "minimum": 0}, "endChar": {"type": "integer", "minimum": 1}, "surfaceSha256": {"$ref": "#/$defs/hash"}, "kind": {"enum": ["semantic", "nonsemantic", "structural"]}, "disposition": {"enum": ["represented", "qualified_uncertainty", "unresolved", "nonsemantic", "structural"]}, "objectRefs": {"type": "array", "items": {"$ref": "#/$defs/ref"}}, "findingIds": {"type": "array", "items": {"type": "string", "minLength": 1}}, "reasonCode": {"type": "string"}, "rationale": {"type": "string", "minLength": 1}}},
    "route": {"type": "object", "additionalProperties": false, "required": ["routeKey", "atomIds", "reportId", "findingIds", "status", "rationale"], "properties": {"routeKey": {"type": "string", "minLength": 1}, "atomIds": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "reportId": {"type": "string"}, "findingIds": {"type": "array", "items": {"type": "string", "minLength": 1}}, "status": {"enum": ["represented", "qualified_uncertainty", "unresolved"]}, "rationale": {"type": "string", "minLength": 1}}},
    "verdict": {"type": "object", "required": ["verdict", "rationale"], "properties": {"verdict": {"enum": ["supported", "qualified", "missing", "unsupported"]}, "rationale": {"type": "string", "minLength": 1}}}
  },
  "oneOf": [
    {"type": "object", "additionalProperties": false, "required": ["schema", "recordId", "packetSha256", "sourceUnitSha256", "atoms", "routes", "recordComplete"], "properties": {"schema": {"const": "al-isabah.knowledge-record-accounting.v1"}, "recordId": {"type": "string", "minLength": 1}, "packetSha256": {"$ref": "#/$defs/hash"}, "sourceUnitSha256": {"type": "object", "additionalProperties": {"$ref": "#/$defs/hash"}}, "atoms": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/atom"}}, "routes": {"type": "array", "items": {"$ref": "#/$defs/route"}}, "recordComplete": {"type": "boolean"}}},
    {"type": "object", "additionalProperties": false, "required": ["schema", "accountingSha256", "candidateOutputSha256", "atomVerdicts", "routeVerdicts", "completenessAssessment", "rationale"], "properties": {"schema": {"const": "al-isabah.knowledge-record-accounting-review.v1"}, "accountingSha256": {"$ref": "#/$defs/hash"}, "candidateOutputSha256": {"$ref": "#/$defs/hash"}, "atomVerdicts": {"type": "array", "items": {"allOf": [{"$ref": "#/$defs/verdict"}, {"type": "object", "required": ["atomId"], "properties": {"atomId": {"type": "string", "minLength": 1}}}]}}, "routeVerdicts": {"type": "array", "items": {"allOf": [{"$ref": "#/$defs/verdict"}, {"type": "object", "required": ["routeKey"], "properties": {"routeKey": {"type": "string", "minLength": 1}}}]}}, "completenessAssessment": {"enum": ["no_missing_known", "residuals"]}, "rationale": {"type": "string", "minLength": 1}}}
  ]
}
