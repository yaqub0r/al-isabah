{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yaqub0r/al-isabah/schemas/local-model-evaluation-identified-packet.v1.schema.json",
  "title": "Al-Isabah identified public review packet v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "reviewPacketId", "evaluationId", "issue", "policySha256", "casesSha256", "runArtifactSha256", "reviewStatus", "roleStatus", "promotionStatus", "limitations", "cases"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "reviewPacketId": {"type": "string", "pattern": "^eval-review-packet-[a-f0-9]{16}$"},
    "evaluationId": {"const": "al-isabah-local-model-v1"},
    "issue": {"const": "https://github.com/yaqub0r/al-isabah/issues/49"},
    "policySha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "casesSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "runArtifactSha256": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
    "reviewStatus": {"const": "unreviewed"}, "roleStatus": {"const": "no-role"}, "promotionStatus": {"const": "blocked"},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "cases": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["caseId", "arabic", "arabicSha256", "candidates"],
      "properties": {
        "caseId": {"type": "string"}, "arabic": {"type": "string"}, "arabicSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "candidates": {"type": "array", "minItems": 1, "items": {
          "type": "object", "additionalProperties": false,
          "required": ["runId", "runSha256", "config", "titleEnglish", "bodyEnglish", "issues", "publicSafety"],
          "properties": {
            "runId": {"type": "string", "pattern": "^eval-run-[a-f0-9]{16}$"}, "runSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
            "config": {
              "type": "object", "additionalProperties": false,
              "required": ["schemaVersion", "configId", "role", "engine", "runtimeVersion", "model", "modelDigest", "artifactDisclosure", "quantization", "houseProfile", "nativeThinkingRequested", "nativeThinkingObserved", "contextTokens", "maxOutputTokens", "temperature", "samplingSeed", "promptVersion", "promptSha256"],
              "properties": {
                "schemaVersion": {"const": "1.0.0"}, "configId": {"type": "string", "minLength": 1}, "role": {"type": "string"},
                "engine": {"type": "string"}, "runtimeVersion": {"type": "string"}, "model": {"type": "string", "minLength": 1},
                "modelDigest": {"type": ["string", "null"]}, "artifactDisclosure": {"type": "string"}, "quantization": {"type": "string"},
                "houseProfile": {"type": "string"}, "nativeThinkingRequested": {"type": "boolean"}, "nativeThinkingObserved": {"type": ["boolean", "null"]},
                "contextTokens": {"type": ["integer", "null"]}, "maxOutputTokens": {"type": ["integer", "null"]}, "temperature": {"type": ["number", "null"]},
                "samplingSeed": {"type": ["integer", "string", "null"]}, "promptVersion": {"type": "string"}, "promptSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
              }
            }, "titleEnglish": {"type": "string"}, "bodyEnglish": {"type": "string"},
            "issues": {"type": "array", "items": {"type": "string"}},
            "publicSafety": {"type": "object", "additionalProperties": false, "required": ["status", "provenance", "admittedBy"], "properties": {"status": {"const": "admitted"}, "provenance": {"const": "sanitized-final-model-output"}, "admittedBy": {"type": "string", "minLength": 1}}}
          }
        }}
      }
    }}
  }
}
