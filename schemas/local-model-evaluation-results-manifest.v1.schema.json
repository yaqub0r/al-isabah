{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yaqub0r/al-isabah/schemas/local-model-evaluation-results-manifest.v1.schema.json",
  "title": "Closed public local-model results admission manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "dependencySha256", "artifacts"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "dependencySha256": {
      "type": "object",
      "minProperties": 6,
      "propertyNames": {"pattern": "^(docs|evaluations)/"},
      "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "artifactType", "sha256", "dependencySha256"],
        "properties": {
          "path": {"type": "string", "pattern": "^evaluations/local-model/v1/results/(?!.*(?:^|/)\\.\\.?/).+\\.(?:json|md)$"},
          "artifactType": {"enum": ["public-index", "source-packet", "attempt-summary", "run", "identified-review-packet", "review", "score", "report"]},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "dependencySha256": {
            "type": "object",
            "minProperties": 6,
            "propertyNames": {"pattern": "^(docs|evaluations)/"},
            "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
          },
          "reportInputs": {
            "type": "object",
            "additionalProperties": false,
            "required": ["cases", "runs", "packet"],
            "properties": {
              "cases": {"type": "string"},
              "runs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
              "packet": {"type": "string"},
              "reviews": {"type": "string"},
              "score": {"type": "string"}
            }
          }
        },
        "allOf": [
          {
            "if": {"properties": {"artifactType": {"const": "report"}}},
            "then": {"required": ["reportInputs"]},
            "else": {"not": {"required": ["reportInputs"]}}
          }
        ]
      }
    }
  }
}
